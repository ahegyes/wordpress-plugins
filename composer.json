{
	"name": "ahegyes/wordpress-plugins",
	"description": "Plugins built on the wp-framework packages are developed side by side here, so a change that crosses plugins lands and is tested in one place, while each plugin still ships from a mirror of its own.",
	"type": "project",
	"license": "GPL-3.0-or-later",
	"homepage": "https://github.com/ahegyes/wordpress-plugins",
	"authors": [
		{
			"name": "Contributors",
			"homepage": "https://github.com/ahegyes/wordpress-plugins/graphs/contributors"
		}
	],

	"repositories": [
		{
			"type": "composer",
			"url": "https://repo.wp-packages.org",
			"only": ["wp-plugin/*", "wp-theme/*"]
		}
	],

	"require": {
		"php": ">=8.5"
	},
	"require-dev": {
		"wp-plugin/woocommerce": "^11.2"
	},

	"minimum-stability": "dev",
	"prefer-stable": true,

	"scripts": {
		"packages-install": "@composer install --ignore-platform-req=php+ --no-interaction",
		"packages-update": [
			"@composer clear-cache",
			"@composer update --prefer-stable --ignore-platform-req=php+ --no-interaction"
		],

		"test:integration": [
			"Composer\\Config::disableProcessTimeout",
			"@putenv CI=1",
			"npm --prefix=. run wp-env:tests:start",
			"@test:integration:run"
		],
		"test:integration:run": [
			"Composer\\Config::disableProcessTimeout",
			"@putenv CI=1",
			"npm --prefix=. run plugins:build",
			"node_modules/.bin/wp-env --config .wp-env.tests.json run cli --env-cwd=wp-content/plugins/linked-orders-for-woocommerce vendor/bin/phpunit --testsuite=Integration",
			"node_modules/.bin/wp-env --config .wp-env.tests.json run cli --env-cwd=wp-content/plugins/internal-comments vendor/bin/phpunit --testsuite=Integration",
			"node_modules/.bin/wp-env --config .wp-env.tests.json run cli --env-cwd=wp-content/plugins/locked-payment-methods-for-woocommerce vendor/bin/phpunit --testsuite=Integration --exclude-group groups"
		],
		"test:integration:ci": [
			"Composer\\Config::disableProcessTimeout",
			"@plugins:packages-install",
			"npm --prefix=. run plugins:packages-install:ci",
			"@test:integration:run"
		],

		"quality-check": [
			"@composer validate --strict",
			"@test:integration"
		],

		"plugins:packages-install": [
			"@composer --working-dir=plugins/linked-orders-for-woocommerce packages-install",
			"@composer --working-dir=plugins/internal-comments packages-install",
			"@composer --working-dir=plugins/locked-payment-methods-for-woocommerce packages-install"
		],
		"plugins:packages-update": [
			"@composer --working-dir=plugins/linked-orders-for-woocommerce packages-update",
			"@composer --working-dir=plugins/internal-comments packages-update",
			"@composer --working-dir=plugins/locked-payment-methods-for-woocommerce packages-update"
		],

		"plugins:format:php": [
			"@composer --working-dir=plugins/linked-orders-for-woocommerce format:php",
			"@composer --working-dir=plugins/internal-comments format:php",
			"@composer --working-dir=plugins/locked-payment-methods-for-woocommerce format:php"
		],
		"plugins:lint:php": [
			"@composer --working-dir=plugins/linked-orders-for-woocommerce lint:php",
			"@composer --working-dir=plugins/internal-comments lint:php",
			"@composer --working-dir=plugins/locked-payment-methods-for-woocommerce lint:php"
		],

		"plugins:test": [
			"@composer --working-dir=plugins/linked-orders-for-woocommerce test",
			"@composer --working-dir=plugins/internal-comments test",
			"@composer --working-dir=plugins/locked-payment-methods-for-woocommerce test"
		],
		"plugins:test:unit": [
			"@composer --working-dir=plugins/linked-orders-for-woocommerce test:unit",
			"@composer --working-dir=plugins/internal-comments test:unit",
			"@composer --working-dir=plugins/locked-payment-methods-for-woocommerce test:unit"
		],
		"plugins:test:integration": [
			"@composer --working-dir=plugins/linked-orders-for-woocommerce test:integration",
			"@composer --working-dir=plugins/internal-comments test:integration",
			"@composer --working-dir=plugins/locked-payment-methods-for-woocommerce test:integration"
		],

		"plugins:quality-check": [
			"@composer --working-dir=plugins/linked-orders-for-woocommerce quality-check",
			"@composer --working-dir=plugins/internal-comments quality-check",
			"@composer --working-dir=plugins/locked-payment-methods-for-woocommerce quality-check"
		]
	},

	"extra": {
		"installer-paths": {
			"vendor/{$vendor}/{$name}/": [
				"type:wordpress-plugin",
				"type:wordpress-theme"
			]
		}
	},

	"config": {
		"allow-plugins": {
			"composer/installers": true
		},
		"sort-packages": true
	}
}
