{
    "name": "@ahegyes/locked-payment-methods-for-woocommerce",
    "private": true,
    "description": "Hides the payment methods you lock from customers at checkout until you unlock them for a user, a role, an order, a group or a membership plan.",
    "license": "GPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ahegyes/wc-locked-payment-methods.git"
    },
    "bugs": "https://github.com/ahegyes/wc-locked-payment-methods/issues",
    "engines": {
        "node": ">=26",
        "npm": ">=11"
    },
    "devDependencies": {
        "@ahegyes/wordpress-configs": "git+https://github.com/ahegyes/wordpress-configs.git#b107001cce9f2960495d9d50481c8540d228f60c",
        "@axe-core/playwright": "^4.14.0",
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.6.6",
        "@wordpress/e2e-test-utils-playwright": "^3.2.0",
        "@wordpress/env": "^12.1.0",
        "@wordpress/scripts": "^37.1.0",
        "typescript": "^6.0.3"
    },
    "scripts": {
        "setup": "npm run packages-install:all && npm run build && npm run wp-env:start",
        "packages-install:all": "composer packages-install && npm run packages-install",
        "packages-update:all": "composer packages-update && npm run packages-update && npm run packages-update:wp",
        "packages-install": "npm install",
        "packages-update": "npm update",
        "packages-update:wp": "wp-scripts packages-update",
        "wp-env": "wp-env",
        "wp-env:start": "wp-env start",
        "wp-env:stop": "wp-env stop",
        "wp-env:update": "wp-env start --update",
        "wp-env:destroy": "wp-env destroy",
        "wp-env:tests:start": "wp-env --config .wp-env.tests.json start",
        "wp-env:tests:stop": "wp-env --config .wp-env.tests.json stop",
        "wp-env:tests:update": "wp-env --config .wp-env.tests.json start --update",
        "wp-env:tests:destroy": "wp-env --config .wp-env.tests.json destroy",
        "build": "exit 0",
        "lint:scripts": "wp-scripts lint-js tests/EndToEnd",
        "lint:styles": "wp-scripts lint-style 'assets/src/**/*.scss' --allow-empty-input",
        "lint:types": "tsc",
        "audit": "composer audit && npm audit",
        "audit:fix": "npm audit fix",
        "check:engines": "wp-scripts check-engines",
        "check:licenses": "wp-scripts check-licenses",
        "test:e2e": "playwright test --config=playwright.config.js"
    }
}
