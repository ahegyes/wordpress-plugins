{
	"name": "@ahegyes/internal-comments",
	"private": true,
	"description": "DWS WordPress plugin template — wp-env, script and style tooling.",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ahegyes/wp-internal-comments.git"
	},
	"bugs": "https://github.com/ahegyes/wordpress-plugins/issues",
	"engines": {
		"node": ">=26",
		"npm": ">=11"
	},
	"devDependencies": {
		"@ahegyes/wordpress-configs": "git+https://github.com/ahegyes/wordpress-configs.git#b107001cce9f2960495d9d50481c8540d228f60c",
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.64.1",
		"@types/node": "^26.6.6",
		"@wordpress/api-fetch": "^8.1.0",
		"@wordpress/e2e-test-utils-playwright": "^3.2.0",
		"@wordpress/env": "^12.1.0",
		"@wordpress/i18n": "^7.1.0",
		"@wordpress/scripts": "^37.1.0",
		"typescript": "^7.0.2"
	},
	"scripts": {
		"setup": "npm run packages-install:all && npm run build && npm run wp-env:start",
		"packages-install:all": "composer packages-install && npm run packages-install",
		"packages-update:all": "composer packages-update && npm run packages-update && npm run packages-update:wp",

		"packages-install": "npm install",
		"packages-update": "npm update",
		"packages-update:wp": "wp-scripts packages-update",

		"build": "npm run build:assets",
		"build:assets": "wp-scripts build meta-box=./assets/src/meta-box.ts quick-view=./assets/src/quick-view.ts --output-path=assets/build",
		"start": "npm run start:assets",
		"start:assets": "wp-scripts start meta-box=./assets/src/meta-box.ts quick-view=./assets/src/quick-view.ts --output-path=assets/build",

		"format": "npm run format:scripts && npm run format:styles",
		"format:scripts": "wp-scripts format assets/src tests/EndToEnd eslint.config.mjs stylelint.config.js playwright.config.js",
		"format:styles": "npm run lint:styles -- --fix",
		"format:all": "( composer format:php || [ $? -eq 1 ] ) && npm run format",

		"lint": "npm run lint:scripts && npm run lint:styles && npm run lint:types",
		"lint:scripts": "wp-scripts lint-js assets/src tests/EndToEnd eslint.config.mjs stylelint.config.js playwright.config.js",
		"lint:styles": "wp-scripts lint-style 'assets/src/**/*.scss'",
		"lint:types": "tsc",
		"lint:all": "composer lint:php && npm run lint",

		"wp-env:start": "wp-env start",
		"wp-env:stop": "wp-env stop",
		"wp-env:update": "wp-env start --update",
		"wp-env:destroy": "wp-env destroy",

		"wp-env:tests:start": "wp-env --config .wp-env.tests.json start",
		"wp-env:tests:stop": "wp-env --config .wp-env.tests.json stop",
		"wp-env:tests:update": "wp-env --config .wp-env.tests.json start --update",
		"wp-env:tests:destroy": "wp-env --config .wp-env.tests.json destroy",

		"wp-env:multisite:start": "wp-env --config .wp-env.multisite.json start",
		"wp-env:multisite:stop": "wp-env --config .wp-env.multisite.json stop",
		"wp-env:multisite:update": "wp-env --config .wp-env.multisite.json start --update",
		"wp-env:multisite:destroy": "wp-env --config .wp-env.multisite.json destroy",

		"audit": "composer audit --locked --abandoned=report && npm audit --omit=dev --audit-level=high",
		"audit:fix": "npm audit fix",
		"check:engines": "wp-scripts check-engines",
		"check:licenses": "wp-scripts check-licenses",

		"test:e2e": "playwright test --config=playwright.config.js",
		"test:all": "composer test && npm run test:e2e",

		"quality-check:all": "composer quality-check && npm run lint && npm run test:e2e"
	}
}
