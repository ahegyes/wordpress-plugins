# The WordPress extensions are listed here because composer.json keeps them from installing themselves.
includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon
	- vendor/johnbillion/wp-compat/extension.neon
	- vendor/swissspidy/phpstan-no-private/rules.neon
	- vendor/ahegyes/wordpress-configs/php/quality-assurance/phpstan.dist.neon

parameters:
	paths:
		- functions.php
		- uninstall.php
		- includes
		- models
		- src
	# phpstan.safeguards.neon analyzes the entry and the safeguards at the oldest runtime they parse on, so this profile only scans them.
	excludePaths:
		- includes/safeguards.php
	scanFiles:
		- linked-orders-for-woocommerce.php
		- includes/safeguards.php
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
		- vendor/php-stubs/woocommerce-stubs/woocommerce-packages-stubs.php
		- tests/Fixtures/class-wc-seq-order-number-pro.php
		- tests/Fixtures/sequential-order-numbers-pro.php
	# The scoped packages load through vendor-prefixed/scoper-autoload.php, which PHPStan does not read.
	scanDirectories:
		- vendor-prefixed
	# wp-compat reads the floor from the entry's Requires at least only while requiresAtLeast, which configs' profile sets, is null.
	WPCompat:
		pluginFile: linked-orders-for-woocommerce.php
		requiresAtLeast: null
