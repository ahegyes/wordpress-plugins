{
    "$schema": "https://schemas.wp.org/trunk/wp-env.schema.json",
    "core": "https://wordpress.org/nightly-builds/wordpress-latest.zip",
    "phpVersion": "8.5",
    "port": 8820,
    "testsEnvironment": false,
    "plugins": [
        "https://downloads.wordpress.org/plugin/woocommerce.latest-stable.zip"
    ],
    "mappings": {
        "wp-content/plugins/internal-comments": "./plugins/internal-comments",
        "wp-content/plugins/linked-orders-for-woocommerce": "./plugins/linked-orders-for-woocommerce",
        "wp-content/plugins/locked-payment-methods-for-woocommerce": "./plugins/locked-payment-methods-for-woocommerce"
    },
    "lifecycleScripts": {
        "afterStart": "wp-env --config .wp-env.tests.json run cli wp plugin activate woocommerce internal-comments linked-orders-for-woocommerce locked-payment-methods-for-woocommerce || true"
    },
    "config": {
        "WP_DEBUG": true,
        "SCRIPT_DEBUG": true
    }
}
